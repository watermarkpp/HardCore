# Godot local cache and generated import metadata
.godot/
*.import
!assets/art/maps/bich/editor_runtime_chunks/*.png.import
!assets/art/maps/wooma_region/editor_runtime_chunks/wooma_forest/*.png.import
# Wall render derived store: committed sidecars make a fresh checkout of
# this SHA importable without a prior local --import pass (R1.1a).
!assets/data/runtime/map_editor/wall_render_store/*.png.import

# Build/export output
outputs/
*.apk
*.aab

# Python and local tooling caches
__pycache__/
*.py[cod]
.pytest_cache/

# Large local source corpora. Worktrees access these through local junctions.
dev_art_sources/

# Bundled local executables/toolchains. Worktrees access these through junctions.
tools/godot-*/
tools/vendor/DepotDownloader/

# Map-editor delivery snapshots and transient backups
map_editor_workspace/_delivery_backups/
map_editor_workspace/*backup*/
map_editor_workspace/**/*backup*

# Common temporary files
*.log
*.tmp
*.temp
Thumbs.db
Desktop.ini
tmp_laser*
*_probe*.gd
# HC-MONSTER-COMBAT-R2 T0: the crowd-scale performance probe is a delivered
# test asset, not a local scratch probe; it must ship with its .tscn so a
# clean checkout can run it. Exception is path-exact on purpose.
!tests/hc_monster_combat_r1/monster_crowd_scale_performance_probe_test.gd
assets/generated/
tools/android-build/
artifacts/
outputs/
tools/android-build/

# Godot imported translation artifacts (remote review 20260916 ruling)
*.translation
