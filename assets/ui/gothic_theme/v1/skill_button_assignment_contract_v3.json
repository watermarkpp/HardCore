{
  "contractId": "ui.skill.button_assignment.v3",
  "policy": "The HUD exposes one assignable attack primary and six attack-ring skill slots. Gameplay owns interaction mode, assignment persistence and attack resolution. Passive skills remain visible in the skill list but are never assignment candidates.",
  "assignmentInput": {
    "method": "SkillPanel.set_skill_button_assignments(assignments, interaction_modes)",
    "hudForwardMethod": "GameHUD.set_skill_button_assignments(assignments, interaction_modes)",
    "groups": {
      "attack": {
        "count": 1,
        "stableSlotIds": [
          "hud.attack.primary"
        ]
      },
      "attack_ring": {
        "count": 6,
        "stableSlotIds": [
          "hud.attack_ring_skill.1",
          "hud.attack_ring_skill.2",
          "hud.attack_ring_skill.3",
          "hud.attack_ring_skill.4",
          "hud.attack_ring_skill.5",
          "hud.attack_ring_skill.6"
        ]
      }
    },
    "eligibleInteractionModes": [
      "toggle",
      "click"
    ],
    "excludedInteractionModes": [
      "passive"
    ]
  },
  "requestSignal": {
    "panelSignal": "SkillPanel.skill_button_assignment_requested(request)",
    "hudForwardSignal": "GameHUD.skill_button_assignment_requested(request)",
    "requestFields": [
      "contract_id",
      "profession_id",
      "skill_id",
      "skill_name",
      "slot_group",
      "slot_index",
      "slot_id",
      "interaction_mode",
      "clear"
    ]
  },
  "clearAssignment": {
    "requestField": "clear",
    "requestValue": true,
    "emptySkillId": "",
    "emptySkillName": "",
    "attackResult": "restore_normal_attack",
    "ringResult": "empty_slot"
  },
  "attackInput": {
    "signal": "GameHUD.attack_pressed",
    "releaseSignal": "GameHUD.attack_released",
    "bindingProjection": "GameHUD attack button bound_skill_name metadata",
    "runtimeResolutionOwner": "integration/professions-skills"
  },
  "compatibility": {
    "previousContractId": "ui.skill.button_assignment.v2",
    "migrationOwner": "gameplay skill loadout service",
    "removedGroup": "center",
    "removedVisibleSlots": 4
  }
}
