  "global_tests": [
    {
      "id": "global_skill_count_33",
      "assert": "len(skills)==33",
      "priority": "P0"
    },
    {
      "id": "global_class_counts",
      "assert": "warrior=6,wizard=14,taoist=13",
      "priority": "P0"
    },
    {
      "id": "global_unique_skill_ids",
      "assert": "all skill_id unique",
      "priority": "P0"
    },
    {
      "id": "global_vanilla_content_layer",
      "assert": "all content_layer=vanilla",
      "priority": "P0"
    },
    {
      "id": "global_no_expansion_skill_in_vanilla",
      "assert": "excluded skill aliases absent",
      "priority": "P0"
    },
    {
      "id": "global_four_ranks_each",
      "assert": "each skill has ranks 0..3",
      "priority": "P0"
    },
    {
      "id": "global_rank_up_requires_level_and_proficiency",
      "assert": "both gates required",
      "priority": "P0"
    },
    {
      "id": "global_proficiency_gain_1_to_3",
      "assert": "eligible success gains deterministic RNG 1..3",
      "priority": "P0"
    },
    {
      "id": "global_failed_action_no_proficiency",
      "assert": "invalid/cancelled/failed action gains 0",
      "priority": "P0"
    },
    {
      "id": "global_proficiency_persists",
      "assert": "save-load preserves rank and proficiency",
      "priority": "P0"
    },
    {
      "id": "global_rank_up_resets_proficiency",
      "assert": "current-rank proficiency resets to 0",
      "priority": "P0"
    },
    {
      "id": "global_single_runtime_entry",
      "assert": "all skill effects route through SkillRuntimeRouter",
      "priority": "P0"
    },
    {
      "id": "global_no_game_root_direct_effect",
      "assert": "_on_player_skill contains no authoritative damage/buff/resource logic",
      "priority": "P0"
    },
    {
      "id": "global_server_authoritative",
      "assert": "client packet cannot choose damage/result",
      "priority": "P0"
    },
    {
      "id": "global_legacy_delay_audit_only",
      "assert": "legacy_delay never drives runtime timing",
      "priority": "P0"
    },
    {
      "id": "global_cast_animation_600ms",
      "assert": "active wizard/taoist casts use 6x100ms body action unless explicit non-vanilla override",
      "priority": "P0"
    },
    {
      "id": "global_raw_pixel_ranges_forbidden",
      "assert": "gameplay geometry uses tiles",
      "priority": "P0"
    },
    {
      "id": "global_multiplier_not_overridden_to_1",
      "assert": "skill rank formulas survive profession rule merge",
      "priority": "P0"
    },
    {
      "id": "global_deterministic_rng_tests",
      "assert": "all probability tests accept injected seeded RNG",
      "priority": "P0"
    }
  ],
