+bool WorkerThreadPool::try_reclaim_completed_group_task(GroupID p_group) {
+#ifdef THREADS_ENABLED
+	// S never waits on task_mutex or the group semaphore. Another poll may
+	// retry at its actual source boundary after competing pool bookkeeping.
+	if (!task_mutex.try_lock()) {
+		return false;
+	}
+	Group **groupp = groups.getptr(p_group);
+	if (!groupp || !(*groupp)->completed.is_set()) {
+		task_mutex.unlock();
+		return false;
+	}
+	Group *group = *groupp;
+	// _process_task posts/completed before its worker tail's finished.inc.
+	// Preserve exactly the original consumer+worker reference protocol.
+	uint32_t max_users = group->tasks_used + 1;
+	uint32_t finished_users = group->finished.increment();
+	// Erase under this same unique consumer claim. A repeated ID cannot
+	// consume the last consumer twice, even while workers leave their tails.
+	groups.erase(p_group);
+	if (finished_users == max_users) {
+		group_allocator.free(group);
+	}
+	task_mutex.unlock();
+#endif
+	return true;
+}
