	//迷你导航按钮
	//迷你导航按钮
document.querySelector('.navbar-toggler-icon').addEventListener('click', function() {
    var collapseElement = document.querySelector('.navbar-collapse');
    if (collapseElement.classList.contains('collapse')) {
        collapseElement.classList.remove('collapse');
    } else {
        collapseElement.classList.add('collapse');
    }
});
	
document.querySelectorAll('.dropdown').forEach(function(dropdown) {
    dropdown.addEventListener('click', function() {
        // 关闭所有下拉菜单
        document.querySelectorAll('.dropdown-menu').forEach(menu => menu.classList.remove('show'));
        document.querySelectorAll('.dropdown').forEach(btn => btn.classList.remove('show'));
        
        // 显示当前点击的菜单
        this.querySelector('.dropdown-menu').classList.add('show');
        this.classList.add('show');
    });
});

document.querySelectorAll('.dropdown-submenu').forEach(function(submenu) {
    submenu.addEventListener('click', function(e) {
        e.stopPropagation(); // 阻止冒泡事件
        this.querySelector('.dropdown-menu').classList.toggle('show');
    });
});</script>
</body>
