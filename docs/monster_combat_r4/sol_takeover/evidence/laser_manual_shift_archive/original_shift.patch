+		assert(effect.global_position.is_equal_approx(Vector2.ZERO))
+		assert(effect.y_sort_enabled and effect.z_index == 0)
+		assert(effect._visual_sort_proxy != null)
+		var expected_sort_y := 0.01 if target_axis.y >= 0.0 else -0.01
+		assert(
+			absf(effect._visual_sort_proxy.global_position.y - expected_sort_y) <= 0.001
+		)
+		assert(effect._formal_core_polygon != null)
+		assert(
+			(effect._formal_core_polygon.global_position - effect.global_position).distance_to(
+				Vector2(0.0, -LASER_CHEST_LIFT_PX)
+			) <= EPSILON_PX
+		)
+		for glow: Polygon2D in effect._formal_core_glow_layers:
+			assert(
+				(glow.global_position - effect.global_position).distance_to(
+					Vector2(0.0, -LASER_CHEST_LIFT_PX)
+				) <= EPSILON_PX
+			)
 		for frame_index: int in range(sprite.frame_count()):
 			assert(sprite.set_manual_frame(frame_index))
+			assert(
+				(sprite.global_position - effect.global_position).distance_to(
+					Vector2(0.0, -LASER_CHEST_LIFT_PX)
+				) <= EPSILON_PX
+			)
 			var visible := _visible_projection_intervals(
 				sprite, target_axis, target_cross
 			)
