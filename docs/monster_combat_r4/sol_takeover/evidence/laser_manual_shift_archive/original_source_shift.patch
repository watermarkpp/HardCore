@@ -8,6 +8,8 @@ const DEFAULT_BEAM_LENGTH_PX := 72.0
 const DEFAULT_SINGLE_ACTIVE_SCOPE := "caster_skill"
 const DEFAULT_SINGLE_ACTIVE_GROUP := "beam"
 const SINGLE_ACTIVE_BEAM_GROUP_PREFIX := "caster_skill_beam_single_active"
+const LASER_CHEST_LIFT_PX := 28.0
+const LASER_FRONT_SORT_BIAS_PX := 0.02
 
 var _visual_profile: Dictionary = {}
 var _lifecycle_mode := "continuous"
@@ -59,6 +61,8 @@ func setup(
 
 func _ready() -> void:
     super._ready()
+    if skill_id == "wizard.laser" and visual_loaded:
+        _place_laser_at_chest_height()
     # Merge lifecycle metadata instead of overwriting -- setup() may have
     # already written snapshot-driven diagnostics (requested_beam_length_px,
     # beam_length_source) that must be preserved for contract verification.
@@ -96,10 +100,44 @@ func _install_single() -> void:
     _apply_beam_width_scale(sprite)
     sprite.self_modulate = Color(1.0, 1.0, 1.0, 1.0)  # Beam: full opacity; formal core polygon handles low-alpha overlay
     sprite.set_process(true)
-    _add_world_visual(sprite)
+    if skill_id == "wizard.laser":
+        # The animation player rebuilds its transform on every frame. Keep the
+        # chest offset on a parent so all six source frames retain one origin.
+        var chest_visual := Node2D.new()
+        chest_visual.name = "LaserChestVisual"
+        _add_world_visual(chest_visual)
+        chest_visual.add_child(sprite)
+    else:
+        _add_world_visual(sprite)
     _sprites.append(sprite)
 
 
+func _place_laser_at_chest_height() -> void:
+    if not is_instance_valid(_visual_sort_proxy):
+        return
+    # The Y-sort key remains at the caster's footpoint. A forward/downward
+    # cast is drawn over that actor; a backward/upward cast stays behind it.
+    var sort_bias := (
+        LASER_FRONT_SORT_BIAS_PX if _beam_axis_screen_px.y >= 0.0 else 0.0
+    )
+    _visual_sort_proxy.position.y += sort_bias
+    var drawables: Array[Node2D] = []
+    for polygon: Polygon2D in _formal_core_polygons:
+        drawables.append(polygon)
+    for glow: Polygon2D in _formal_core_glow_layers:
+        drawables.append(glow)
+    if not _sprites.is_empty():
+        var chest_visual := _sprites[0].get_parent() as Node2D
+        if is_instance_valid(chest_visual):
+            drawables.append(chest_visual)
+    for drawable: Node2D in drawables:
+        drawable.position.y -= LASER_CHEST_LIFT_PX + sort_bias
+    # The opt-in geometry debug overlay still reports the unchanged ground
+    # footprint; only the production beam art is lifted.
+    if is_instance_valid(_debug_geometry_overlay):
+        _debug_geometry_overlay.position.y -= sort_bias
+
+
 func beam_debug_metadata() -> Dictionary:
     return _beam_debug_metadata.duplicate(true)
 
