+		"source_class":"direct","damage_channel":"magic_defense","requested_damage":15,
+		"hp_before":10,"hp_after":0,"actual_loss":10,"target_survived_commit":false,
+		"target":{"world":{"epoch":1},"runtime_id":20,"life_generation":3},"source":{},
