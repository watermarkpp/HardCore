+	if later==null: game.queue_free(); _finish(); return
+	var third: EnemyActor=null
+	if chain_depth==2:
+		third=game._spawn_enemy(GameData.get_monster_by_id(19),
+			game._canonical_ground_gu_to_screen_px(Vector2(45.7,13.5)),false,-1.0,
