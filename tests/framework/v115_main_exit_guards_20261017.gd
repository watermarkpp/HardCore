extends Node
## Real candidate parsing and actual Native prestart refusal boundaries only.
## This does not manufacture a closing Host, Source journal ACK or terminal IO.
const Proof := preload("res://tests/framework/helpers/check_receipt.gd")
var proof := Proof.new()
var failures := 0
func check(value: bool, label: String) -> void:
	proof.record(value,label)
	if not value: failures += 1; print("MAIN_EXIT_GUARD_FAIL ",label)
func _ready() -> void: _run.call_deferred()
func _run() -> void:
	check(OS.get_user_data_dir().replace("\\","/").contains("/.godot/runtime_appdata/"),"actual isolated userdata")
	var names: Array[String] = ["main_boot_application","main_boot_root_transport","main_boot_launch_loading","main_session_transport","main_boot_main_composition","main_startup_application_producer","main_source_lifecycle_driver"]
	for name: String in names:
		var code: Script = load("res://scripts/gameplay/source/"+name+".gd")
		check(code != null and code.can_instantiate(),"actual candidate compiles "+name)
	var host: Object = ClassDB.instantiate("HardCoreSimulationHost")
	check(host != null and host.is_class("HardCoreSimulationHost"),"real Native Host instantiated")
	var native: Dictionary = host.status()
	check(native.get("started") == false and native.get("running") == false,"actual Native stays unstarted")
	var actual_executable: String = OS.get_executable_path()
	var binary_sha: String = FileAccess.get_sha256(actual_executable)
	check(binary_sha in ["1b753fd8ee77e1a4e3565c4f38d18c92fd4a2436865ab79b3ef6e6e8a8fd3097","dcd9e00454a7af58148842616d698861b997a5846bbe951d3fbf1e0cfa072983"],"actual executing fixed mailbox/RNG terminal-return Native PE bytes")
	check(host.has_method("retire_started_original_main_channels"),"actual linked Host exposes the started-only retirement method")
	if host.has_method("retire_started_original_main_channels"):
		var refused: Dictionary = host.call("retire_started_original_main_channels",{})
		check(refused.get("success") == false and refused.get("error") == "actual_started_joined_terminal_required","actual unstarted Host cannot mint normal terminal owner retirement")
		check(host.call("retire_started_original_main_channels",{}) == refused,"repeating an invalid request does not advance retirement")
		check(host.status().get("main_channels_unbound_after_close") == false and host.status().get("started") == false,"actual rejected detach preserves Host lifetime flags")
	print("MAIN_EXIT_GUARD_ACTUAL_PE ",actual_executable," sha256=",binary_sha)
	var app := preload("res://scripts/gameplay/source/main_boot_application.gd").new()
	var caster := preload("res://scripts/gameplay/world/world_caster_main_executor.gd").new()
	check(app.release_actual_original_world_loading_pins(1,caster).get("success") != true,"missing actual Source final event cannot release real Caster")
	check(caster.get("_closed") == false and caster.get("_host") == null,"refused pin release does not close foreign Caster")
	check(app.finish_actual_original_application_quit().get("success") != true,"direct quit cannot bypass actual process-frame owner")
	check(app.actual_original_terminal_exit().is_empty(),"refusal creates no terminal receipt")
	var source_root_witness := preload("res://scripts/gameplay/world/world_root_phase_adapter.gd").new()
	var source_id: int = source_root_witness.get_instance_id()
	check(source_id < 0,"real allocated SourceRoot RefCounted ID is negative on this engine")
	var schema_world: Dictionary = {"contract_id":"hardcore.execution.world_context.v1","world_runtime_id":get_instance_id(),"profile_id":"exit_schema_guard","runtime_map_id":-1,"world_epoch":0}
	var source_fact: Dictionary = {"contract_id":"hardcore.source.Root_final_free.v1","owner_session_id":7,"closure_id":7,"world_context":schema_world,"source_root_id":source_id,"exit_step":17,"children_exited":true,"children_final_freed":true}
	check(app.accepts_original_source_root_final_free_fact(source_fact,7,7,schema_world),"actual negative Source RefCounted witness accepted by production schema only")
	var invalid_fact: Dictionary = source_fact.duplicate(true); invalid_fact.source_root_id = 0
	check(not app.accepts_original_source_root_final_free_fact(invalid_fact,7,7,schema_world),"zero Source witness rejected")
	invalid_fact = source_fact.duplicate(true); invalid_fact.source_root_id = float(source_id)
	check(not app.accepts_original_source_root_final_free_fact(invalid_fact,7,7,schema_world),"floating Source ObjectID rejected without truncation")
	invalid_fact = source_fact.duplicate(true); invalid_fact.erase("children_final_freed")
	check(not app.accepts_original_source_root_final_free_fact(invalid_fact,7,7,schema_world),"missing Source final-free field rejected")
	invalid_fact = source_fact.duplicate(true); invalid_fact.exit_step = 16
	check(not app.accepts_original_source_root_final_free_fact(invalid_fact,7,7,schema_world),"step16 cannot stand in for final-free")
	check(not app.accepts_original_source_root_final_free_fact(source_fact,8,7,schema_world),"foreign owner session rejected")
	check(not app.accepts_original_source_root_final_free_fact(source_fact,7,7,{}),"foreign world rejected")
	var made_up := {"kind":"original_world_presentation","operation":&"original_source_root_final_free","arguments":[{"contract_id":"hardcore.source.Root_final_free.v1","owner_session_id":1,"closure_id":1,"world_context":{},"source_root_id":1,"exit_step":17,"children_exited":true,"children_final_freed":true}],"source_site":{}}
	check(app.apply_original_main_journal_event(made_up).get("success") != true,"freestanding Source final-free dictionary has no Native prefix authority")
	check(app.get("_actual_source_root_exit").is_empty(),"unadmitted final-free cannot mint Source exit witness")
	check(app.apply_original_main_journal_event({"kind":"original_world_presentation","operation":&"unknown_exit_please_ack"}).get("status") == "INVALID","unknown journal tail remains INVALID")
	var bridge := preload("res://scripts/gameplay/source/main_boot_root_transport.gd").new()
	var root := Node2D.new()
	var attachment := preload("res://scripts/gameplay/world/world_main_root_attachment.gd").new()
	check(not bridge.record_actual_original_source_root_exit(root,attachment),"unbound physical Root callback cannot authorize normal exit")
	check(bridge.finish_actual_original_terminal_root_exit({}, {"success":true}).get("success") != true,"a caller READY bit cannot remove Root")
	check(is_instance_valid(root),"rejected exit keeps actual Node alive")
	root.free()
	var transport := preload("res://scripts/gameplay/source/main_session_transport.gd").new()
	check(transport.actual_original_terminal_intent().is_empty(),"new transport has no inferred quit intent")
	check(not transport.retire_actual_started_terminal_listener({"success":true}),"unstarted transport refuses fabricated terminal listener release")
	var loading := preload("res://scripts/gameplay/source/main_boot_launch_loading.gd").new()
	check(loading.actual_retained_terminal_receiver() == null,"missing hall does not produce retained receiver proof")
	check(loading.retire_actual_original_terminal_receiver({"success":true},transport).get("success") != true,"unverified terminal cannot retire CharacterSelect")
	var composition := preload("res://scripts/gameplay/source/main_boot_main_composition.gd").new()
	check(composition.retire_actual_started_terminal_channels({"success":true}).get("success") != true,"blank graph cannot retire Native-bound producers")
	var producer := preload("res://scripts/gameplay/source/main_startup_application_producer.gd").new()
	check(producer.retire_actual_started_terminal_preparation(app,{"success":true}).get("success") != true,"foreign receipt cannot release catalogue or physical facade")
	var facade := preload("res://scripts/features/runtime/feature_resource_main_facade.gd").new()
	check(not facade._actual_terminal_code_owner_cancel_no_work(self,1),"blank facade cannot skip actual CharacterSelect cancel")
	facade.free()
	var feature := preload("res://scripts/features/runtime/feature_resource_main_primitives.gd").new()
	check(loading.release_actual_original_terminal_code_observation({},feature).get("success") != true,"unadmitted code observer release retains actual lease authority")
	check(loading.get("_terminal_code_lease") == null,"rejected code release creates no weakref retirement proof")
	var scene: PackedScene = load("res://scenes/main.tscn")
	var actual: Dictionary = preload("res://scripts/gameplay/source/main_boot_root_transport.gd").inspect_actual_Main_constructor(host,scene,preload("res://scripts/game_root.gd"))
	check(actual.get("success") == true,"actual Native prestart Main constructor preflight remains available")
	check(host.status().get("started") == false and host.status().get("running") == false,"guard checks never start Source or bind gameplay")
	var valid: bool = proof.write_receipt("v115_main_exit_guards_20261017",proof.records.size(),failures)
	print("V115_MAIN_EXIT_GUARDS_20261017_", "PASS" if valid else "FAIL", " checks=",proof.records.size()," failures=",failures)
	get_tree().quit(0 if valid else 1)
