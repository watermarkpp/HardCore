static func source_round(value: float) -> int:
	# Delphi Round uses nearest-even for an exact halfway value.
	var lower := int(floor(value))
	var fraction := value - float(lower)
	if absf(fraction - 0.5) < 0.000000001:
		return lower if lower % 2 == 0 else lower + 1
	return int(floor(value + 0.5))
